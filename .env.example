# Buffer free plan — publish.buffer.com/settings/api (connect your X account in Buffer first)
BUFFER_API_KEY=
# The setup wizard fills this in for you (or run `python bot.py --list-channels`)
BUFFER_CHANNEL_ID=

# Groq free tier — console.groq.com/keys (no credit card required)
GROQ_API_KEY=

# Optional — only for finance accounts that want Finnhub market news (finnhub.io/register, free)
FINNHUB_API_KEY=
